rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFamilyMember(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)) &&
        request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberIds;
    }

    function isFamilyAdmin(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)) &&
        request.auth.uid == get(/databases/$(database)/documents/families/$(familyId)).data.adminId;
    }

    // Check if user is requesting to join a family (can only modify pendingMembers, not members/memberIds)
    function isRequestingJoin() {
      return isSignedIn() &&
        request.resource.data.memberIds == resource.data.memberIds &&
        request.resource.data.members == resource.data.members;
    }

    // Check if user is only adding themselves to memberIds (child account self-register)
    function isAddingSelfToMemberIds() {
      return isSignedIn() &&
        request.resource.data.members == resource.data.members &&
        request.auth.uid in request.resource.data.memberIds &&
        !(request.auth.uid in resource.data.memberIds);
    }

    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Families collection
    match /families/{familyId} {
      // Read: signed-in users can read (needed for join by code, child login)
      allow read: if isSignedIn();

      // Update: admin can do anything, members can update, signed-in users can request to join or self-register as child
      allow update: if isFamilyAdmin(familyId) ||
        isFamilyMember(familyId) ||
        (isSignedIn() && isRequestingJoin()) ||
        (isSignedIn() && isAddingSelfToMemberIds());

      // Anyone signed in can create a family
      allow create: if isSignedIn() &&
        request.resource.data.adminId == request.auth.uid;

      // Only admin can delete family
      allow delete: if isFamilyAdmin(familyId);
    }

    // Shopping items - only family members can access
    match /shopping-items/{itemId} {
      allow read, write: if isSignedIn() &&
        isFamilyMember(resource.data.familyId);

      allow create: if isSignedIn() &&
        isFamilyMember(request.resource.data.familyId);
    }

    // Shopping lists - only family members can access
    match /shopping-lists/{listId} {
      allow read, write: if isSignedIn() &&
        isFamilyMember(resource.data.familyId);

      allow create: if isSignedIn() &&
        isFamilyMember(request.resource.data.familyId);
    }

    // Lists (used by app) - only family members can access
    match /lists/{listId} {
      allow read, write: if isSignedIn() &&
        isFamilyMember(resource.data.familyId);

      allow create: if isSignedIn() &&
        isFamilyMember(request.resource.data.familyId);
    }

    // Shopping history - only family members can access
    match /shopping-history/{historyId} {
      allow read, write: if isSignedIn() &&
        isFamilyMember(resource.data.familyId);

      allow create: if isSignedIn() &&
        isFamilyMember(request.resource.data.familyId);
    }

    // Chat messages - only family members can access
    match /chat-messages/{messageId} {
      allow read, write: if isSignedIn() &&
        isFamilyMember(resource.data.familyId);

      allow create: if isSignedIn() &&
        isFamilyMember(request.resource.data.familyId) &&
        request.resource.data.userId == request.auth.uid;
    }

    // Family chat (alternative collection used by app)
    match /family-chat/{messageId} {
      allow read, write: if isSignedIn() &&
        isFamilyMember(resource.data.familyId);

      allow create: if isSignedIn() &&
        isFamilyMember(request.resource.data.familyId);
    }

    // Activity log - only family members can access
    match /activity-log/{logId} {
      allow read: if isSignedIn() &&
        isFamilyMember(resource.data.familyId);

      allow create: if isSignedIn() &&
        isFamilyMember(request.resource.data.familyId);

      // No update or delete for audit trail
      allow update, delete: if false;
    }

    // Forgotten stats - only family members can access
    match /forgotten-stats/{statsId} {
      allow read, write: if isSignedIn() &&
        statsId.matches(request.auth.uid + '_.*') ||
        isFamilyMember(resource.data.familyId);

      allow create: if isSignedIn() &&
        isFamilyMember(request.resource.data.familyId);
    }

    // Feedback - anyone signed in can create, only admins can read
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false; // Admin SDK only
    }

    // Recipes - family members can access family recipes
    match /recipes/{recipeId} {
      allow read, write: if isSignedIn() &&
        isFamilyMember(resource.data.familyId);

      allow create: if isSignedIn() &&
        isFamilyMember(request.resource.data.familyId);
    }

    // Calendar events - family members can access
    match /calendar-events/{eventId} {
      allow read, write: if isSignedIn() &&
        isFamilyMember(resource.data.familyId);

      allow create: if isSignedIn() &&
        isFamilyMember(request.resource.data.familyId);
    }

    // Reminder history - family members can read, system can write
    match /reminder-history/{historyId} {
      allow read: if isSignedIn() &&
        isFamilyMember(resource.data.familyId);

      // Only allow creates from family members (manual reminders)
      // Scheduled reminders are created via Admin SDK (server-side)
      allow create: if isSignedIn() &&
        isFamilyMember(request.resource.data.familyId);

      // No update or delete for audit trail
      allow update, delete: if false;
    }

    // Push subscriptions - users can manage their own subscriptions
    match /push-subscriptions/{subId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow read, delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
